{
  "permissions": {
    "allow": [
      "Bash(tool/verify.sh)",
      "Bash(tool/verify.sh:*)",
      "Bash(tool/tree_hash.sh)",
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(dart analyze:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tool/session_context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tool/commit_gate.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tool/edit_guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tool/edit_guard.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
